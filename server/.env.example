# MT5 Monitor - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database
DB_PATH=./data/mt5monitor.db

# Security - CHANGE THESE IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-1234567890
ENCRYPTION_KEY=your-32-char-encryption-key-1234567890ab

# CORS
CORS_ORIGIN=https://your-domain.com

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=MT5 Monitor <noreply@your-domain.com>

# Push Notifications (optional - VAPID keys for Web Push)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.com